  "metadata": {"isOfficial": true, "scope": "국가 공통 분리배출 지침", "lastVerified": "2026-07-11", "sourceName": "환경부 재활용품별 분리배출 방법", "sourceUrl": "https://eng.me.go.kr/home/file/readDownloadFile2.do?fileId=286620&fileSeq=1&openYn=Y", "regionalRuleStatus": "지역별 구체적인 품목·방법은 지자체 조례 및 공식 공지 확인 필요"},
  "rules": {
    "transparent_pet":{"collectionType":"투명 페트병 별도 분리배출","steps":["내용물을 비웁니다.","물로 헹굽니다.","라벨을 제거합니다.","가능하면 압착합니다.","투명 페트병 수거함에 배출합니다."]},
    "colored_pet":{"collectionType":"플라스틱 분리배출","steps":["내용물을 비우고 세척합니다.","재질 표시를 확인합니다.","투명 페트병과 섞지 않고 플라스틱 수거함에 배출합니다."]},
    "plastic_container":{"collectionType":"플라스틱 분리배출","steps":["내용물을 제거합니다.","세척 가능한 오염은 씻어 냅니다.","다른 재질 부속품을 분리합니다.","플라스틱 수거함에 배출합니다."]},
    "vinyl":{"collectionType":"비닐류 분리배출","steps":["이물질을 제거합니다.","물기와 음식물 오염을 없앱니다.","깨끗한 비닐만 비닐류 수거함에 배출합니다."]},
    "styrofoam":{"collectionType":"스티로폼 분리배출","steps":["테이프와 운송장을 제거합니다.","이물질을 털어 냅니다.","전용 수거함 표기를 확인해 배출합니다."]},
    "aluminum_can":{"collectionType":"캔류 분리배출","steps":["내용물을 비우고 헹굽니다.","플라스틱 뚜껑을 분리합니다.","캔 수거함에 배출합니다."]},
    "steel_can":{"collectionType":"캔류 분리배출","steps":["내용물을 비우고 세척합니다.","다른 재질 부속품을 분리합니다.","캔 수거함에 배출합니다."]},
    "glass_bottle":{"collectionType":"유리병 분리배출","steps":["내용물을 비우고 헹굽니다.","뚜껑을 분리합니다.","깨지지 않게 유리병 수거함에 배출합니다."]},
    "paper_box":{"collectionType":"종이류 분리배출","steps":["테이프와 완충재를 제거합니다.","접어서 부피를 줄입니다.","종이류 수거함에 배출합니다."]},
    "paper_cup":{"collectionType":"종이류 분리배출","steps":["내용물을 비우고 세척합니다.","완전히 말립니다.","지역 수거함 표기에 따라 종이류로 배출합니다."]},
    "milk_carton":{"collectionType":"종이팩 별도 수거","steps":["내용물을 비우고 헹굽니다.","펼쳐 말립니다.","종이팩 전용 수거함에 배출합니다."]},
    "contaminated_container":{"collectionType":"세척 후 재활용 또는 일반폐기물","steps":["음식물을 완전히 제거합니다.","세척 가능한지 확인합니다.","세척이 어려우면 지역 종량제 기준을 확인합니다."]},
    "battery":{"collectionType":"폐건전지 전용 수거","steps":["일반쓰레기와 섞지 않습니다.","가까운 폐건전지 전용 수거함에 넣습니다."]},
    "fluorescent":{"collectionType":"폐형광등 전용 수거","steps":["깨뜨리지 않도록 포장합니다.","일반쓰레기와 섞지 않습니다.","전용 수거함 또는 지정 수거처를 이용합니다."]},
    "composite":{"collectionType":"재질 확인 필요","steps":["재질별로 분리 가능한 부분을 나눕니다.","분리가 어려우면 지역 수거 기준을 확인합니다.","사진만으로 지역 규정은 확정하지 않습니다."]}
  }
